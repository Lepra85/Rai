# Rai domain service — copy to .env and fill in.
# .env is gitignored.

# Postgres connection string. Use the Supabase "Connection string"
# value (URI mode). Example shape:
#   postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
# For Supabase + connection pooling, use port 6543 (PgBouncer).
DATABASE_URL=

# Shared secret used to authenticate webhook node calls from the Kapso flow
# to this service. Generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
FLOW_API_SECRET=

# Kapso platform API key, used to send WhatsApp messages via the Kapso
# REST API (https://api.kapso.ai/meta/whatsapp/...).
KAPSO_API_KEY=

# Kapso webhook signing secret. Set in Kapso dashboard → Webhooks → your
# webhook → "Secret". Kapso signs every inbound webhook with HMAC-SHA256
# and sends the hex digest in `X-Webhook-Signature`.
KAPSO_WEBHOOK_SECRET=

# Optional default WhatsApp Business phone_number_id for outbound sends.
# Single-tenant convenience; multi-tenant code passes empresa.phone_number_id
# explicitly per call.
WHATSAPP_DEFAULT_PHONE_NUMBER_ID=
