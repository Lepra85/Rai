[Unit]
Description=Rai Telegram Bot (OpenAI Agents SDK)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rai
Group=rai
WorkingDirectory=/home/rai/repo/agent
EnvironmentFile=/home/rai/repo/agent/.env
ExecStart=/home/rai/repo/agent/.venv/bin/python /home/rai/repo/agent/bot.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/rai-bot.log
StandardError=append:/var/log/rai-bot.log

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/rai /var/log

[Install]
WantedBy=multi-user.target
