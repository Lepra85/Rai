# Caddy config for the Rai domain service.
# Public hostname uses DuckDNS free DNS: raiagent.duckdns.org → droplet IPv4.
# duckdns.org is on the Public Suffix List so Let's Encrypt treats each
# subdomain as its own registered domain — independent rate limits.
#
# When you migrate to a real domain, swap the host line below and run
#   sudo systemctl reload caddy
# Nothing else changes — same upstream, same routes.

raiagent.duckdns.org {
	encode zstd gzip

	# Forward everything to the FastAPI service bound to localhost.
	reverse_proxy 127.0.0.1:8000 {
		# Pass real client IP + proto so the app sees HTTPS, not HTTP.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Basic access log.
	log {
		output file /var/log/caddy/rai-service.log
		format console
	}
}
