# Caddy config for the Rai domain service.
# Public hostname uses sslip.io free DNS: <dashed-ip>.sslip.io resolves to
# the droplet's public IPv4. Let's Encrypt issues a real cert against this
# hostname automatically.
#
# When you migrate to a real domain, swap the host line below and run
#   sudo systemctl reload caddy
# Nothing else changes — same upstream, same routes.

159-203-122-175.sslip.io {
	encode zstd gzip

	# Forward everything to the FastAPI service bound to localhost.
	reverse_proxy 127.0.0.1:8000 {
		# Pass real client IP + proto so the app sees HTTPS, not HTTP.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Basic access log.
	log {
		output file /var/log/caddy/rai-service.log
		format console
	}
}
