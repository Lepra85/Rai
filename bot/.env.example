# Copy this file to .env and fill in the real values.
# This file is read by /opt/rai/bot/main.py via systemd EnvironmentFile.

# Required: token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Required: comma-separated list of Telegram chat ids that are allowed to use the bot.
# Get yours by messaging @userinfobot in Telegram, or send /id to your bot once it runs.
# Example: RAI_ALLOWED_CHAT_IDS=123456789,987654321
RAI_ALLOWED_CHAT_IDS=

# Optional overrides
# CLAUDE_BIN=claude
# RAI_WORK_DIR=/home/rai
# RAI_SESSIONS_FILE=/home/rai/.rai/sessions.json
# RAI_TIMEOUT_S=180
